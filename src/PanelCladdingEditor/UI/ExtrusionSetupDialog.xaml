<Window x:Class="PanelCladdingEditor.UI.ExtrusionSetupDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Extrusion setup" Width="1220" Height="820" MinWidth="1040" MinHeight="700"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip"
        Background="#FAFBFC" Foreground="#263239" FontFamily="Segoe UI" FontSize="13"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Window.Resources>
        <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="MutedBrush" Color="#748087" />
        <SolidColorBrush x:Key="BorderBrush" Color="#DDE3E7" />
        <SolidColorBrush x:Key="BorderStrongBrush" Color="#AEB8BE" />
        <SolidColorBrush x:Key="RaisedBrush" Color="#F4F6F7" />
        <SolidColorBrush x:Key="HoverBrush" Color="#EEF1F3" />
        <SolidColorBrush x:Key="AccentBrush" Color="#229447" />
        <SolidColorBrush x:Key="DangerBrush" Color="#C73E3E" />
        <Style x:Key="EyebrowText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="BaseButton" TargetType="Button">
            <Setter Property="Height" Value="38" />
            <Setter Property="Padding" Value="13,0" />
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="Foreground" Value="#263239" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderStrongBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style x:Key="PrimaryButton" BasedOn="{StaticResource BaseButton}" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
        </Style>
        <Style x:Key="DangerButton" BasedOn="{StaticResource BaseButton}" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
        </Style>
        <Style x:Key="FormTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="38" />
            <Setter Property="Padding" Value="9,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderStrongBrush}" />
        </Style>
        <Style x:Key="TileItem" TargetType="ListBoxItem">
            <Setter Property="Width" Value="148" />
            <Setter Property="Height" Value="132" />
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="Padding" Value="6" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                    <Setter Property="BorderThickness" Value="2" />
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource HoverBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <DataTemplate x:Key="ProfileTile">
            <Grid ToolTip="{Binding DisplayName}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="2">
                    <Image Source="{Binding Thumbnail}" Stretch="Uniform" />
                </Border>
                <TextBlock Grid.Row="1" Text="{Binding PrimaryCode}" FontFamily="Consolas" FontSize="11"
                           FontWeight="SemiBold" TextAlignment="Center" Margin="0,5,0,0"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Row="2" Text="{Binding ConfigurationSummary}" FontSize="10" Foreground="{StaticResource MutedBrush}"
                           TextAlignment="Center" TextTrimming="CharacterEllipsis" />
            </Grid>
        </DataTemplate>
        <GroupStyle x:Key="CategoryGroup">
            <GroupStyle.HeaderTemplate>
                <DataTemplate>
                    <Border Background="#F4F6F7" Padding="8,5" Margin="0,5,0,8">
                        <TextBlock Text="{Binding Name}" FontSize="11" FontWeight="SemiBold" Foreground="#5C6970" />
                    </Border>
                </DataTemplate>
            </GroupStyle.HeaderTemplate>
            <GroupStyle.Panel>
                <ItemsPanelTemplate><StackPanel /></ItemsPanelTemplate>
            </GroupStyle.Panel>
        </GroupStyle>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Padding="18,13" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid>
                <StackPanel>
                    <TextBlock Text="Extrusion setup" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock Text="Extract every schedule page, configure each profile, then save the project catalogue."
                               Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,2,0,0" />
                </StackPanel>
                <Button Content="&#x00D7;" Width="38" Padding="0" FontSize="20" HorizontalAlignment="Right"
                        Style="{StaticResource BaseButton}" Click="OnCancelClick" />
            </Grid>
        </Border>
        <Border Grid.Row="1" Padding="18,12" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="42"/></Grid.ColumnDefinitions>
                <TextBlock Text="PROJECT WORKBOOK" Style="{StaticResource EyebrowText}" VerticalAlignment="Center" />
                <TextBox x:Name="WorkbookPathText" Grid.Column="1" Style="{StaticResource FormTextBox}" />
                <Button Grid.Column="3" Content="&#x2026;" FontSize="18" Padding="0" Style="{StaticResource BaseButton}" Click="OnBrowseWorkbookClick" />
            </Grid>
        </Border>
        <Border Grid.Row="2" Padding="18,12" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="42"/><ColumnDefinition Width="8"/><ColumnDefinition Width="135"/></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="SCHEDULE PDF" Style="{StaticResource EyebrowText}" />
                    <TextBlock x:Name="ImportStatusText" Text="All schedule pages will be imported." FontSize="10" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
                </StackPanel>
                <TextBox x:Name="PdfPathText" Grid.Column="1" Style="{StaticResource FormTextBox}" />
                <Button Grid.Column="3" Content="&#x2026;" FontSize="18" Padding="0" Style="{StaticResource BaseButton}" Click="OnBrowsePdfClick" />
                <Button x:Name="ExtractButton" Grid.Column="5" Content="Extract all pages" Style="{StaticResource PrimaryButton}" Click="OnExtractClick" />
            </Grid>
        </Border>

        <Grid Grid.Row="3" Margin="18,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="330"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="12">
                <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <StackPanel Margin="0,0,0,8">
                        <TextBlock Text="UNCONFIGURED POOL" Style="{StaticResource EyebrowText}" />
                        <TextBlock x:Name="PoolCountText" FontSize="11" Foreground="{StaticResource MutedBrush}" />
                    </StackPanel>
                    <ListBox x:Name="PoolList" Grid.Row="1" BorderThickness="0" Background="Transparent"
                             ItemContainerStyle="{StaticResource TileItem}" ItemTemplate="{StaticResource ProfileTile}"
                             SelectionChanged="OnProfileSelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ListBox.ItemsPanel>
                        <ListBox.GroupStyle><StaticResource ResourceKey="CategoryGroup" /></ListBox.GroupStyle>
                    </ListBox>
                </Grid>
            </Border>

            <Border Grid.Column="2" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="16">
                <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
                    <TextBlock Text="PROFILE CONFIGURATION" Style="{StaticResource EyebrowText}" />
                    <Border Height="140" Margin="0,10,0,8" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="5">
                        <Image x:Name="EditorPreview" Stretch="Uniform" />
                    </Border>
                    <TextBlock x:Name="EditorCodeText" Text="Select a profile" FontFamily="Consolas" FontSize="16" FontWeight="SemiBold" TextAlignment="Center" />
                    <TextBlock x:Name="EditorDescriptionText" Foreground="{StaticResource MutedBrush}" FontSize="11" TextAlignment="Center" TextWrapping="Wrap" Margin="0,3,0,12" />
                    <TabControl x:Name="DimensionTabs" SelectionChanged="OnDimensionChanged">
                        <TabItem Header="1D — length based">
                            <StackPanel Margin="10">
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="100"/></Grid.ColumnDefinitions>
                                    <StackPanel><TextBlock Text="VALUE" Style="{StaticResource EyebrowText}"/><TextBox Text="LL" IsReadOnly="True" Style="{StaticResource FormTextBox}" Margin="0,5,0,0"/></StackPanel>
                                    <StackPanel Grid.Column="2"><TextBlock Text="QUANTITY" Style="{StaticResource EyebrowText}"/><TextBox x:Name="QuantityText" Style="{StaticResource FormTextBox}" Margin="0,5,0,0" ToolTip="Blank means one piece"/></StackPanel>
                                </Grid>
                                <TextBlock Text="Blank quantity means one. Quantity 2 produces LL*2." Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,7,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </TabItem>
                        <TabItem Header="0D — counted">
                            <StackPanel Margin="10">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="FixedRadio" Content="Fixed quantity" IsChecked="True" Checked="OnCalculationModeChanged"/>
                                    <RadioButton x:Name="SpacingRadio" Content="Every x inches" Margin="18,0,0,0" Checked="OnCalculationModeChanged"/>
                                </StackPanel>
                                <TextBlock x:Name="ZeroValueLabel" Text="QUANTITY" Style="{StaticResource EyebrowText}" Margin="0,10,0,0"/>
                                <TextBox x:Name="ZeroValueText" Style="{StaticResource FormTextBox}" Margin="0,5,0,0"/>
                            </StackPanel>
                        </TabItem>
                    </TabControl>
                    <TextBlock Text="PARENT EXTRUSION (OPTIONAL)" Style="{StaticResource EyebrowText}" Margin="0,13,0,0"/>
                    <ComboBox x:Name="ParentCodeCombo" Height="38" Margin="0,5,0,0" />
                    <TextBlock Text="The parent is added only when this profile is first assigned. A manual deletion stays deleted." Foreground="{StaticResource MutedBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,6,0,0"/>
                    <Button x:Name="ConfigureButton" Content="Move to ready catalogue" Style="{StaticResource PrimaryButton}" Margin="0,14,0,0" Click="OnConfigureClick" IsEnabled="False"/>
                    <Button x:Name="ReturnButton" Content="Return to pool" Style="{StaticResource DangerButton}" Margin="0,8,0,0" Click="OnReturnToPoolClick" IsEnabled="False"/>
                </StackPanel></ScrollViewer>
            </Border>

            <Border Grid.Column="4" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="12">
                <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <StackPanel Margin="0,0,0,8">
                        <TextBlock Text="READY CATALOGUE" Style="{StaticResource EyebrowText}" />
                        <TextBlock x:Name="ReadyCountText" FontSize="11" Foreground="{StaticResource MutedBrush}" />
                    </StackPanel>
                    <ListBox x:Name="ReadyList" Grid.Row="1" BorderThickness="0" Background="Transparent"
                             ItemContainerStyle="{StaticResource TileItem}" ItemTemplate="{StaticResource ProfileTile}"
                             SelectionChanged="OnProfileSelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ListBox.ItemsPanel>
                        <ListBox.GroupStyle><StaticResource ResourceKey="CategoryGroup" /></ListBox.GroupStyle>
                    </ListBox>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="4" Padding="18,12" Background="{StaticResource RaisedBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Width="116" Style="{StaticResource BaseButton}" Click="OnCancelClick" />
                <Button Content="Confirm" Width="116" Margin="8,0,0,0" Style="{StaticResource PrimaryButton}" Click="OnAcceptClick" />
            </StackPanel>
        </Border>
    </Grid>
</Window>

<Window x:Class="PanelCladdingEditor.UI.PanelCladdingEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:PanelCladdingEditor.UI"
        Title="Panel Cladding Editor"
        Width="1380" Height="860" MinWidth="980" MinHeight="680"
        WindowStartupLocation="CenterOwner"
        Background="#FAFBFC" Foreground="#263239"
        FontFamily="Segoe UI" FontSize="14"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Window.Resources>
        <SolidColorBrush x:Key="BackgroundBrush" Color="#FAFBFC" />
        <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="ForegroundBrush" Color="#263239" />
        <SolidColorBrush x:Key="MutedBrush" Color="#748087" />
        <SolidColorBrush x:Key="BorderBrush" Color="#DDE3E7" />
        <SolidColorBrush x:Key="BorderStrongBrush" Color="#AEB8BE" />
        <SolidColorBrush x:Key="RaisedBrush" Color="#F4F6F7" />
        <SolidColorBrush x:Key="HoverBrush" Color="#EEF1F3" />
        <SolidColorBrush x:Key="PressedBrush" Color="#E5EAED" />
        <SolidColorBrush x:Key="SelectedViewBrush" Color="#3E494F" />
        <SolidColorBrush x:Key="AccentBrush" Color="#229447" />
        <SolidColorBrush x:Key="AccentHoverBrush" Color="#197D3B" />
        <SolidColorBrush x:Key="DangerBrush" Color="#B2332C" />
        <SolidColorBrush x:Key="WarningSoftBrush" Color="#FFF0D2" />
        <SolidColorBrush x:Key="SuccessSoftBrush" Color="#DFF4E4" />

        <Style TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="EyebrowText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextWrapping" Value="NoWrap" />
        </Style>

        <Style x:Key="MetaLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Margin" Value="0,0,0,2" />
        </Style>

        <Style x:Key="MetaValue" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="TextWrapping" Value="NoWrap" />
        </Style>

        <Style x:Key="DividerOffsetEditor" TargetType="TextBox">
            <Setter Property="Height" Value="25" />
            <Setter Property="Padding" Value="4,0" />
            <Setter Property="HorizontalContentAlignment" Value="Right" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="EditorBorder" CornerRadius="5"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="EditorBorder" Property="Background" Value="{StaticResource SurfaceBrush}" />
                                <Setter TargetName="EditorBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BaseButton" TargetType="Button">
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="Padding" Value="13,0" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderStrongBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource HoverBrush}" />
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{StaticResource ForegroundBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource PressedBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="ButtonBorder" Property="BorderThickness" Value="2" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.55" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CompactButton" BasedOn="{StaticResource BaseButton}" TargetType="Button">
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Padding" Value="9,0" />
            <Setter Property="FontSize" Value="11" />
        </Style>

        <Style x:Key="FooterButton" BasedOn="{StaticResource BaseButton}" TargetType="Button">
            <Setter Property="Padding" Value="6,0" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <Style x:Key="PrimaryButton" BasedOn="{StaticResource BaseButton}" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource AccentHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource RaisedBrush}" />
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DangerButton" BasedOn="{StaticResource BaseButton}" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
            <Setter Property="BorderBrush" Value="#D9A19D" />
        </Style>

        <Style x:Key="CompactDangerButton" BasedOn="{StaticResource DangerButton}" TargetType="Button">
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Padding" Value="9,0" />
            <Setter Property="FontSize" Value="11" />
        </Style>

        <Style x:Key="SegmentButton" BasedOn="{StaticResource BaseButton}" TargetType="Button">
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Tag" Value="Unselected" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource HoverBrush}" />
                            </Trigger>
                            <Trigger Property="Tag" Value="Selected">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource SurfaceBrush}" />
                                <Setter TargetName="ButtonBorder" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect BlurRadius="3" ShadowDepth="1" Opacity="0.14" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.65" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ViewSegmentButton" BasedOn="{StaticResource BaseButton}" TargetType="Button">
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Tag" Value="Unselected" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}"
                                CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource HoverBrush}" />
                            </Trigger>
                            <Trigger Property="Tag" Value="Selected">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource SelectedViewBrush}" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.65" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FormTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="40" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderStrongBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="FieldBorder" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="FieldBorder" Property="BorderBrush" Value="{StaticResource ForegroundBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="FieldBorder" Property="Background" Value="{StaticResource RaisedBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FormComboBox" TargetType="ComboBox">
            <Setter Property="Height" Value="40" />
            <Setter Property="Padding" Value="10,7,32,7" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}" />
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderStrongBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="FontFamily" Value="Segoe UI" />
                        <Setter Property="FontSize" Value="13" />
                        <Setter Property="Padding" Value="10,7" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="FieldBorder" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                                <Grid>
                                    <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center"
                                                      Content="{TemplateBinding SelectionBoxItem}"
                                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                      ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                                      IsHitTestVisible="False" />
                                    <Path Width="8" Height="5" HorizontalAlignment="Right" VerticalAlignment="Center"
                                          Margin="0,0,12,0" Fill="{StaticResource MutedBrush}"
                                          Data="M 0,0 L 8,0 4,5 Z" IsHitTestVisible="False" />
                                    <ToggleButton Background="Transparent" BorderThickness="0" Focusable="False"
                                                  ClickMode="Press"
                                                  IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                        <ToggleButton.Template>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Border Background="Transparent" />
                                            </ControlTemplate>
                                        </ToggleButton.Template>
                                    </ToggleButton>
                                </Grid>
                            </Border>
                            <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom"
                                   AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                                <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        MaxHeight="240" Margin="0,4,0,0" Padding="3"
                                        Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderStrongBrush}"
                                        BorderThickness="1" CornerRadius="6">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" CanContentScroll="True">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="FieldBorder" Property="BorderBrush" Value="{StaticResource ForegroundBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="FieldBorder" Property="Background" Value="{StaticResource RaisedBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ToolbarComboBox" BasedOn="{StaticResource FormComboBox}" TargetType="ComboBox">
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Padding" Value="9,5,28,5" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <Style x:Key="SideSection" TargetType="Border">
            <Setter Property="Padding" Value="18,17" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
        </Style>

        <DataTemplate x:Key="MaterialChipTemplate" DataType="{x:Type ui:PanelCladdingMaterial}">
            <Button Style="{StaticResource BaseButton}" MinHeight="32" Padding="6,3" Margin="0,0,5,5"
                    HorizontalContentAlignment="Stretch"
                    PreviewMouseLeftButtonDown="OnMaterialChipMouseDown"
                    PreviewMouseMove="OnMaterialChipMouseMove"
                    Click="OnMaterialChipClick"
                    ToolTip="{Binding DisplayName}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="11" />
                        <ColumnDefinition Width="5" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="11" Height="11" CornerRadius="2" Background="{Binding Brush}"
                            BorderBrush="#40000000" BorderThickness="1" />
                    <TextBlock Grid.Column="2" Text="{Binding Code}" FontFamily="Consolas"
                               FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                </Grid>
            </Button>
        </DataTemplate>

        <DataTemplate x:Key="ExtrusionTileTemplate" DataType="{x:Type ui:PanelFrameExtrusion}">
            <Border Height="126" Padding="6" Margin="0,0,7,7" CornerRadius="5"
                    Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" Cursor="Hand"
                    PreviewMouseLeftButtonDown="OnExtrusionTileMouseDown"
                    PreviewMouseMove="OnExtrusionTileMouseMove" ToolTip="{Binding DisplayName}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Border Background="White" BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1" CornerRadius="4" Padding="2">
                        <Image Source="{Binding Thumbnail}" Stretch="Uniform" />
                    </Border>
                    <TextBlock Grid.Row="1" Text="{Binding Code}" FontFamily="Consolas"
                               FontSize="10" FontWeight="SemiBold" TextAlignment="Center"
                               TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="0,5,0,0" />
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="AssignedExtrusionTileTemplate" DataType="{x:Type ui:PanelExtrusionAssignmentCard}">
            <Border Height="126" Padding="6" Margin="0,0,7,7" CornerRadius="5"
                    Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" ToolTip="{Binding DisplayName}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Border Background="White" BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1" CornerRadius="4" Padding="2">
                        <Image Source="{Binding Thumbnail}" Stretch="Uniform" />
                    </Border>
                    <Grid Grid.Row="1" Margin="0,5,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="52" />
                            <ColumnDefinition Width="24" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Code}" FontFamily="Consolas" FontSize="10"
                                   FontWeight="SemiBold" VerticalAlignment="Center"
                                   TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                        <TextBox Grid.Column="1" Height="24" Padding="4,0" Margin="4,0,3,0"
                                 Text="{Binding ModifierText, Mode=OneWay}" VerticalContentAlignment="Center"
                                 FontFamily="Consolas" FontSize="10" ToolTip="{Binding ModifierToolTip}"
                                 PreviewKeyDown="OnAssignedModifierPreviewKeyDown"
                                 LostKeyboardFocus="OnAssignedModifierLostKeyboardFocus" />
                        <Button Grid.Column="2" Content="×" Width="22" Height="24" Padding="0"
                                Style="{StaticResource CompactDangerButton}"
                                Click="OnRemoveExtrusionAssignmentClick"
                                ToolTip="Remove this profile from the selected curves" />
                    </Grid>
                </Grid>
            </Border>
        </DataTemplate>

    </Window.Resources>

    <Grid>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="620" />
                <ColumnDefinition Width="360" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" Background="{StaticResource BackgroundBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="48" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border Grid.Row="0" Background="{StaticResource RaisedBrush}"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                    <Grid Margin="18,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Padding="2" CornerRadius="6" Background="{StaticResource SurfaceBrush}"
                                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                <Grid Width="238">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Button x:Name="ExtrusionViewButton" Content="Extrusion view" Style="{StaticResource ViewSegmentButton}"
                                            Click="OnExtrusionViewClick" />
                                    <Button x:Name="CladdingViewButton" Grid.Column="1" Content="Cladding view"
                                            Style="{StaticResource ViewSegmentButton}" Tag="Selected" Click="OnCladdingViewClick" />
                                </Grid>
                            </Border>
                        </StackPanel>
                        <StackPanel x:Name="ToolbarActions" Grid.Column="1" Orientation="Horizontal"
                                    HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button x:Name="ClearCellsButton" Content="Clear assignment"
                                    Style="{StaticResource CompactDangerButton}" Height="32" Margin="0,0,8,0"
                                    Click="OnClearCellsClick" />
                            <ComboBox x:Name="ZoomCombo" Width="82" Height="32" Style="{StaticResource ToolbarComboBox}"
                                      VerticalAlignment="Center" SelectedIndex="4" SelectionChanged="OnZoomChanged">
                                <ComboBoxItem Content="80%" Tag="0.8" />
                                <ComboBoxItem Content="85%" Tag="0.85" />
                                <ComboBoxItem Content="90%" Tag="0.9" />
                                <ComboBoxItem Content="95%" Tag="0.95" />
                                <ComboBoxItem Content="100%" Tag="1" />
                                <ComboBoxItem Content="105%" Tag="1.05" />
                                <ComboBoxItem Content="110%" Tag="1.1" />
                                <ComboBoxItem Content="115%" Tag="1.15" />
                                <ComboBoxItem Content="120%" Tag="1.2" />
                                <ComboBoxItem Content="125%" Tag="1.25" />
                                <ComboBoxItem Content="130%" Tag="1.3" />
                                <ComboBoxItem Content="135%" Tag="1.35" />
                                <ComboBoxItem Content="140%" Tag="1.4" />
                                <ComboBoxItem Content="145%" Tag="1.45" />
                                <ComboBoxItem Content="150%" Tag="1.5" />
                            </ComboBox>
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid x:Name="CanvasWorkspace" Grid.Row="1" Background="{StaticResource BackgroundBrush}" ClipToBounds="True">
                    <ui:PanelCladdingGridCanvas x:Name="PanelGridCanvas"
                                                 SelectionChanged="OnCanvasSelectionChanged"
                                                 ExtrusionSelectionChanged="OnCanvasExtrusionSelectionChanged"
                                                  DimensionValueCommitted="OnDimensionValueCommitted"
                                                  DimensionLockToggleRequested="OnDimensionLockToggleRequested"
                                                  ZoomChanged="OnCanvasZoomChanged"
                                                 MullionPlacementRequested="OnMullionPlacementRequested"
                                                 MaterialDropped="OnCanvasMaterialDropped" />
                    <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,15,18,0"
                            Padding="10,7" CornerRadius="5" Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="TOTAL PANEL SIZE" Foreground="{StaticResource MutedBrush}"
                                       FontSize="9" FontWeight="SemiBold" TextAlignment="Right" />
                            <TextBlock x:Name="OverallSizeText" Text="—" FontFamily="Consolas" FontSize="12"
                                       FontWeight="SemiBold" TextAlignment="Right" Margin="0,1,0,0" />
                        </StackPanel>
                    </Border>
                    <StackPanel x:Name="ExtrusionActions" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                                Margin="0,0,0,14" Orientation="Horizontal" Visibility="Collapsed">
                        <Border x:Name="MergeActionGroup" Padding="4" CornerRadius="7"
                                Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1">
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="MergeExtrusionsButton" Content="Merge" Style="{StaticResource CompactButton}"
                                        MinWidth="58" Click="OnMergeExtrusionsClick" />
                                <Button x:Name="ExplodeExtrusionsButton" Content="Explode" Style="{StaticResource CompactButton}"
                                        MinWidth="62" Margin="5,0,0,0" Click="OnExplodeExtrusionsClick" />
                                <Button x:Name="HideExtrusionsButton" Content="Hide" Style="{StaticResource CompactButton}"
                                        MinWidth="58" Margin="5,0,0,0" Click="OnHideExtrusionsClick" />
                            </StackPanel>
                        </Border>
                        <Border x:Name="EditActionGroup" Margin="8,0,0,0" Padding="4" CornerRadius="7"
                                Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1">
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="AddHorizontalMullionButton" Content="Add H" Style="{StaticResource CompactButton}"
                                        MinWidth="56" Click="OnAddHorizontalMullionClick" />
                                <Button x:Name="AddVerticalMullionButton" Content="Add V" Style="{StaticResource CompactButton}"
                                        MinWidth="56" Margin="5,0,0,0" Click="OnAddVerticalMullionClick" />
                                <Button x:Name="DeleteExtrusionsButton" Content="Delete" Style="{StaticResource CompactDangerButton}"
                                        MinWidth="56" Margin="5,0,0,0" Click="OnDeleteExtrusionsClick" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <Border x:Name="ToastBorder" Panel.ZIndex="20"
                            HorizontalAlignment="Center" VerticalAlignment="Bottom"
                            Margin="0,0,0,78" Padding="14,9" CornerRadius="6" Background="#E9263239"
                            Visibility="Collapsed">
                        <TextBlock x:Name="ToastText" Foreground="White" FontSize="12" TextWrapping="NoWrap" />
                    </Border>
                </Grid>
            </Grid>

            <Border Grid.Column="1" Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <Border Style="{StaticResource SideSection}">
                                <StackPanel>
                                    <TextBlock Text="CURRENT PANEL" Style="{StaticResource EyebrowText}" Margin="0,0,0,6" />
                                    <Grid>
                                        <TextBlock x:Name="PanelIdText" Text="—" FontFamily="Consolas" FontSize="18"
                                                   FontWeight="SemiBold" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                                                   Margin="0,0,80,0" />
                                        <Border x:Name="DirtyBadge" HorizontalAlignment="Right" VerticalAlignment="Top"
                                                Background="{StaticResource WarningSoftBrush}" CornerRadius="99" Padding="7,3">
                                            <TextBlock x:Name="DirtyBadgeText" Text="Unsaved" FontSize="11" FontWeight="SemiBold" />
                                        </Border>
                                    </Grid>
                                    <Grid Margin="0,13,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="68" />
                                            <ColumnDefinition Width="1" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                            <TextBlock Text="Wall type" Style="{StaticResource MetaLabel}" />
                                            <TextBlock x:Name="WallTypeText" Text="—" Style="{StaticResource MetaValue}"
                                                       FontSize="14" Margin="0,2,0,16" />
                                            <TextBlock Text="Units" Style="{StaticResource MetaLabel}" />
                                            <TextBlock x:Name="UnitsText" Text="—" Style="{StaticResource MetaValue}"
                                                       FontSize="14" Margin="0,2,0,0" />
                                        </StackPanel>
                                        <Border Grid.Column="1" Background="{StaticResource BorderBrush}" />
                                        <StackPanel Grid.Column="2" Margin="12,0,0,0">
                                            <TextBlock Text="Divider offsets" Style="{StaticResource MetaLabel}" Margin="0,0,0,5" />
                                            <ItemsControl x:Name="DividerOffsetList">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="0,0,6,7" Height="25">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="22" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="{Binding Code}" FontFamily="Consolas" FontSize="10"
                                                                       FontWeight="SemiBold" VerticalAlignment="Center" />
                                                            <Border Grid.ColumnSpan="2" VerticalAlignment="Bottom" Height="1"
                                                                    Background="{StaticResource BorderBrush}" />
                                                            <TextBox Grid.Column="1" Text="{Binding Display, Mode=OneWay}"
                                                                     Style="{StaticResource DividerOffsetEditor}" Tag="{Binding}" MinWidth="64"
                                                                     GotKeyboardFocus="OnDividerOffsetGotKeyboardFocus"
                                                                     PreviewKeyDown="OnDividerOffsetPreviewKeyDown"
                                                                     LostKeyboardFocus="OnDividerOffsetLostKeyboardFocus" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <UniformGrid Columns="2" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Grid>
                                 </StackPanel>
                             </Border>

                            <Border x:Name="CladdingAssignmentSection" Style="{StaticResource SideSection}">
                                <StackPanel>
                                    <TextBlock Text="CELL ASSIGNMENT" Style="{StaticResource EyebrowText}" />
                                    <Border Margin="0,12,0,14" Padding="2" CornerRadius="6"
                                            Background="{StaticResource RaisedBrush}" BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Button x:Name="MaterialTabButton" Content="Material" Style="{StaticResource SegmentButton}"
                                                    Tag="Selected" Click="OnMaterialTabClick" />
                                            <Button x:Name="ParentTabButton" Grid.Column="1" Content="Parent cell"
                                                    Style="{StaticResource SegmentButton}" Click="OnParentTabClick" />
                                        </Grid>
                                    </Border>
                                    <TextBlock Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,0,0,12">
                                        <Run x:Name="SelectedCountText" Text="0 cells" FontWeight="SemiBold"
                                             Foreground="{StaticResource ForegroundBrush}" />
                                        <Run Text=" will be updated" />
                                    </TextBlock>
                                    <StackPanel x:Name="MaterialAssignmentPanel">
                                         <TextBlock Text="MATERIAL CODE" Style="{StaticResource EyebrowText}" Margin="0,0,0,5" />
                                         <ComboBox x:Name="MaterialSelect" Style="{StaticResource FormComboBox}"
                                                   DisplayMemberPath="DisplayName"
                                                   SelectionChanged="OnMaterialSelectionChanged" />
                                     </StackPanel>
                                     <StackPanel x:Name="ParentAssignmentPanel" Visibility="Collapsed">
                                         <TextBlock Text="PARENT-CELL REFERENCE" Style="{StaticResource EyebrowText}" Margin="0,0,0,5" />
                                         <ComboBox x:Name="ParentReferenceSelect" Style="{StaticResource FormComboBox}"
                                                   DisplayMemberPath="ShortLabel"
                                                   SelectionChanged="OnParentSelectionChanged" />
                                         <TextBlock Text="The selected cell inherits its parent’s material. A shared mullion becomes dashed."
                                                    Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,7,0,0" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border x:Name="MaterialLegendSection" Style="{StaticResource SideSection}">
                                <StackPanel>
                                    <Grid Margin="0,0,0,9">
                                        <TextBlock Text="DRAG MATERIALS" Style="{StaticResource EyebrowText}" VerticalAlignment="Center" />
                                        <Button x:Name="ManageMaterialsButton" Content="＋  Setup" Style="{StaticResource CompactButton}"
                                                HorizontalAlignment="Right" Click="OnManageMaterialsClick" />
                                    </Grid>
                                    <ItemsControl x:Name="MaterialLegend" ItemTemplate="{StaticResource MaterialChipTemplate}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Columns="3" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <Border x:Name="ExtrusionAssignmentSection" Style="{StaticResource SideSection}"
                                    Visibility="Collapsed" AllowDrop="True"
                                    PreviewDragOver="OnExtrusionAssignmentDragOver"
                                    PreviewDrop="OnExtrusionAssignmentDrop">
                                <StackPanel>
                                    <TextBlock Text="EXTRUSION ASSIGNMENT" Style="{StaticResource EyebrowText}" />
                                    <TextBlock Margin="0,10,0,12" Foreground="{StaticResource MutedBrush}" FontSize="12">
                                        <Run x:Name="SelectedExtrusionCountText" Text="0 extrusions" FontWeight="SemiBold"
                                             Foreground="{StaticResource ForegroundBrush}" />
                                        <Run Text=" selected" />
                                    </TextBlock>
                                    <Border Padding="11" CornerRadius="6" Background="{StaticResource RaisedBrush}"
                                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,7">
                                                <TextBlock Text="ASSIGNED PROFILE CODES" Style="{StaticResource EyebrowText}"
                                                           VerticalAlignment="Center" />
                                                <Button x:Name="ClearExtrusionAssignmentsButton" Content="Clear all"
                                                        Style="{StaticResource CompactDangerButton}" Height="28"
                                                        HorizontalAlignment="Right" Click="OnClearExtrusionAssignmentsClick" />
                                            </Grid>
                                            <ItemsControl x:Name="SelectedExtrusionAssignments"
                                                          ItemTemplate="{StaticResource AssignedExtrusionTileTemplate}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <UniformGrid Columns="2" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                            </ItemsControl>
                                            <TextBlock x:Name="ExtrusionAssignmentHelpText"
                                                       Text="Select a frame or intermediate curve, then drag a profile here."
                                                       Foreground="{StaticResource MutedBrush}" FontSize="11"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <Border x:Name="ExtrusionLegendSection" Style="{StaticResource SideSection}" Visibility="Collapsed">
                                <StackPanel>
                                    <Grid Margin="0,0,0,9">
                                        <TextBlock Text="DRAG EXTRUSIONS" Style="{StaticResource EyebrowText}"
                                                   VerticalAlignment="Center" />
                                        <Button x:Name="ManageExtrusionsButton" Content="＋  Setup"
                                                Style="{StaticResource CompactButton}" HorizontalAlignment="Right"
                                                Click="OnManageExtrusionsClick" />
                                    </Grid>
                                    <TextBlock x:Name="ExtrusionCatalogueEmptyText"
                                               Text="Use Setup to import the project extrusion schedule PDF."
                                               Foreground="{StaticResource MutedBrush}" FontSize="11"
                                               TextWrapping="Wrap" Margin="0,0,0,8" />
                                    <ItemsControl x:Name="ExtrusionLegend" ItemTemplate="{StaticResource ExtrusionTileTemplate}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Columns="2" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <Border x:Name="FrameTypologySection" Style="{StaticResource SideSection}" Visibility="Collapsed">
                                <StackPanel>
                                    <TextBlock Text="FRAME TYPOLOGY" Style="{StaticResource EyebrowText}" />
                                    <Border Margin="0,11,0,0" Padding="12,11" CornerRadius="6"
                                            Background="{StaticResource RaisedBrush}" BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="1">
                                        <StackPanel>
                                            <TextBlock Text="CALCULATED KEY" Style="{StaticResource EyebrowText}" />
                                            <TextBlock x:Name="FrameTypologyText" Text="UNASSIGNED"
                                                       FontFamily="Consolas" FontSize="16" FontWeight="SemiBold"
                                                       Margin="0,2,0,3" TextWrapping="Wrap" />
                                            <TextBlock Text="Stored at CW_1.5D_FRAME TYPOLOGY when at least one profile code is assigned."
                                                       Foreground="{StaticResource MutedBrush}" FontSize="11"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>

                        </StackPanel>
                    </ScrollViewer>

                    <Border Grid.Row="1" Padding="18,14,18,16" Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
                        <StackPanel>
                            <Grid Margin="0,0,0,10">
                                <TextBlock x:Name="FooterStatusText" Text="Changes not saved"
                                           Foreground="{StaticResource MutedBrush}" FontSize="11" />
                                <TextBlock Text="Rhino panel data" HorizontalAlignment="Right"
                                           Foreground="{StaticResource MutedBrush}" FontSize="11" />
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button x:Name="SaveExtrusionsButton" Content="Save Extrusions" Height="40"
                                        Style="{StaticResource FooterButton}" Click="OnSaveExtrusionsClick" />
                                <Button x:Name="SaveCladdingButton" Grid.Column="2" Content="Save Cladding" Height="40"
                                        Style="{StaticResource FooterButton}" Click="OnSaveCladdingClick" />
                                <Button x:Name="SaveButton" Grid.Column="4" Content="Save Both"
                                        Height="40" Style="{StaticResource PrimaryButton}"
                                        Padding="6,0" FontSize="12" Click="OnSaveClick" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>

    </Grid>
</Window>

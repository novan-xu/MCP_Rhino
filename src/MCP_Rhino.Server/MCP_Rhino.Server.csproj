<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <McpRhinoCliHost Condition="'$(McpRhinoCliHost)' == ''">false</McpRhinoCliHost>
    <McpRhinoIsolatedRuntime Condition="'$(McpRhinoIsolatedRuntime)' == ''">false</McpRhinoIsolatedRuntime>
    <OutputType Condition="'$(McpRhinoIsolatedRuntime)' == 'true' or '$(McpRhinoCliHost)' != 'true'">Library</OutputType>
    <OutputType Condition="'$(McpRhinoIsolatedRuntime)' != 'true' and '$(McpRhinoCliHost)' == 'true'">Exe</OutputType>
    <AssemblyName Condition="'$(McpRhinoIsolatedRuntime)' == 'true'">MCP_Rhino.Server.Runtime</AssemblyName>
    <TargetExt Condition="'$(McpRhinoIsolatedRuntime)' == 'true'">.dll</TargetExt>
    <TargetExt Condition="'$(McpRhinoIsolatedRuntime)' != 'true' and '$(McpRhinoCliHost)' == 'true'">.dll</TargetExt>
    <TargetExt Condition="'$(McpRhinoIsolatedRuntime)' != 'true' and '$(McpRhinoCliHost)' != 'true'">.rhp</TargetExt>
    <GenerateDependencyFile>true</GenerateDependencyFile>
    <DefineConstants Condition="'$(McpRhinoIsolatedRuntime)' == 'true'">$(DefineConstants);MCP_RHINO_ISOLATED_RUNTIME</DefineConstants>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>MCP_Rhino.Server</RootNamespace>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.5" />
    <PackageReference Include="ModelContextProtocol" Version="1.1.0" />
    <PackageReference Include="System.Drawing.Common" Version="7.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MCP_Rhino.Transport\MCP_Rhino.Transport.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="RhinoCommon" Aliases="rhinocommon">
      <HintPath>C:\Program Files\Rhino 8\System\netcore\RhinoCommon.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Grasshopper">
      <HintPath>C:\Program Files\Rhino 8\Plug-ins\Grasshopper\Grasshopper.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="GH_IO">
      <HintPath>C:\Program Files\Rhino 8\Plug-ins\Grasshopper\GH_IO.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>


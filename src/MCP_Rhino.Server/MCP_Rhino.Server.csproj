<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <McpRhinoCliHost Condition="'$(McpRhinoCliHost)' == ''">false</McpRhinoCliHost>
    <McpRhinoIsolatedRuntime Condition="'$(McpRhinoIsolatedRuntime)' == ''">false</McpRhinoIsolatedRuntime>
    <OutputType Condition="'$(McpRhinoIsolatedRuntime)' == 'true' or '$(McpRhinoCliHost)' != 'true'">Library</OutputType>
    <OutputType Condition="'$(McpRhinoIsolatedRuntime)' != 'true' and '$(McpRhinoCliHost)' == 'true'">Exe</OutputType>
    <AssemblyName Condition="'$(McpRhinoIsolatedRuntime)' == 'true'">MCP_Rhino.Server.Runtime</AssemblyName>
    <TargetExt Condition="'$(McpRhinoIsolatedRuntime)' == 'true'">.dll</TargetExt>
    <TargetExt Condition="'$(McpRhinoIsolatedRuntime)' != 'true' and '$(McpRhinoCliHost)' == 'true'">.dll</TargetExt>
    <TargetExt Condition="'$(McpRhinoIsolatedRuntime)' != 'true' and '$(McpRhinoCliHost)' != 'true'">.rhp</TargetExt>
    <GenerateDependencyFile>true</GenerateDependencyFile>
    <DefineConstants Condition="'$(McpRhinoIsolatedRuntime)' == 'true'">$(DefineConstants);MCP_RHINO_ISOLATED_RUNTIME</DefineConstants>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>MCP_Rhino.Server</RootNamespace>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.5" />
    <PackageReference Include="ModelContextProtocol" Version="1.1.0" />
    <PackageReference Include="System.Drawing.Common" Version="7.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MCP_Rhino.Transport\MCP_Rhino.Transport.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="RhinoCommon" Aliases="rhinocommon">
      <HintPath>C:\Program Files\Rhino 8\System\netcore\RhinoCommon.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Grasshopper">
      <HintPath>C:\Program Files\Rhino 8\Plug-ins\Grasshopper\Grasshopper.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="GH_IO">
      <HintPath>C:\Program Files\Rhino 8\Plug-ins\Grasshopper\GH_IO.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\..\Project_Test\**\*.cs"
             Exclude="..\..\Project_Test\260507_TEST_debug-bridge-only-plugin\**\*.cs;
                      ..\..\Project_Test\260507_TEST_panel-runtime-policy\**\*.cs;
                      ..\..\Project_Test\260509_TEST_companion-image-attachments\**\*.cs;
                      ..\..\Project_Test\260729_TEST_multi-document-rhino-router\RouterProtocolSmoke\**\*.cs;
                      ..\..\Project_Test\260804_TEST_panel-cladding-type-editor\**\*.cs;
                       ..\..\Project_Test\260804_TEST_standalone-panel-cladding-editor\**\*.cs;
                       ..\..\Project_Test\260805_TEST_panel-cladding-spawn\**\*.cs;
                       ..\..\Project_Test\260805_TEST_panel-cladding-match\**\*.cs;
                       ..\..\Project_Test\260807_TEST_panel-cladding-clear\**\*.cs;
                       ..\..\Project_Test\260807_TEST_panel-cladding-surface-sync\**\*.cs;
                       ..\..\Project_Test\260812_TEST_panel-cladding-regions\**\*.cs;
                       ..\..\Project_Test\260812_TEST_panel-cladding-offset-sync\**\*.cs;
                       ..\..\Project_Test\260804_TEST_direct-rhp-plugin-identity\RhpExecutableProbe\**\*.cs;
                      ..\..\Project_Test\260805_TEST_rhino-plugin-assembly-identity\PluginAssemblyIdentityProbe\**\*.cs;
                      ..\..\Project_Test\260805_TEST_grasshopper-authoring-tools\ApiProbe\**\*.cs"
             LinkBase="Project_Test" />
    <Compile Include="..\..\Project_Archive\Project_Test\**\*.cs"
             Exclude="..\..\Project_Archive\Project_Test\260505_TEST_rhino-claude-code-panel\**\*.cs;
                      ..\..\Project_Archive\Project_Test\260506_TEST_llm-panel-cli-switching\**\*.cs;
                      ..\..\Project_Archive\Project_Test\260506_TEST_multi-rhino-panel-pipes\**\*.cs;
                      ..\..\Project_Archive\Project_Test\260506_TEST_rhino-chat-file-lock-safety\**\*.cs;
                      ..\..\Project_Archive\Project_Test\260506_TEST_rhino-chat-save-safety\**\*.cs;
                      ..\..\Project_Archive\Project_Test\260506_TEST_rhino-claude-code-companion-ui\**\*.cs"
             LinkBase="Project_Archive\Project_Test" />
  </ItemGroup>

  <!-- Production is an automatic Router host, not a Rhino command surface. -->
  <ItemGroup Condition="'$(McpRhinoIsolatedRuntime)' != 'true' and '$(McpRhinoCliHost)' != 'true'">
    <Compile Remove="Infrastructure\Plugin\*Command.cs" />
  </ItemGroup>

  <ItemGroup Condition="'$(McpRhinoIsolatedRuntime)' == 'true'">
    <Compile Remove="Infrastructure\Plugin\MCP_Rhino.RhinoPlugin.cs" />
    <Compile Remove="Infrastructure\Plugin\PluginLoadContext.cs" />
    <Compile Remove="Infrastructure\Plugin\*Command.cs" />
    <Compile Remove="Infrastructure\Plugin\Routing\RoutedDocumentEndpointDispatcher.cs" />
  </ItemGroup>

  <!-- Only the RHP carries the Rhino plug-in id; the isolated runtime and the CLI host must not
       repeat it, so that the package can never ship two assemblies claiming one plug-in identity. -->
  <ItemGroup Condition="'$(McpRhinoIsolatedRuntime)' == 'true' or '$(McpRhinoCliHost)' == 'true'">
    <Compile Remove="AssemblyInfo.cs" />
  </ItemGroup>

  <ItemGroup Condition="'$(McpRhinoCliHost)' != 'true'">
    <Compile Remove="Program.cs" />
  </ItemGroup>

</Project>

  <!-- Production is an automatic Router host, not a Rhino command surface. -->
  <ItemGroup Condition="'$(McpRhinoIsolatedRuntime)' != 'true' and '$(McpRhinoCliHost)' != 'true'">
    <Compile Remove="Infrastructure\Plugin\*Command.cs" />
  </ItemGroup>

  <ItemGroup Condition="'$(McpRhinoIsolatedRuntime)' == 'true'">
    <Compile Remove="Infrastructure\Plugin\MCP_Rhino.RhinoPlugin.cs" />
    <Compile Remove="Infrastructure\Plugin\PluginLoadContext.cs" />
    <Compile Remove="Infrastructure\Plugin\*Command.cs" />
    <Compile Remove="Infrastructure\Plugin\Routing\RoutedDocumentEndpointDispatcher.cs" />
  </ItemGroup>

  <!-- Only the RHP carries the Rhino plug-in id; the isolated runtime and the CLI host must not
       repeat it, so that the package can never ship two assemblies claiming one plug-in identity. -->
  <ItemGroup Condition="'$(McpRhinoIsolatedRuntime)' == 'true' or '$(McpRhinoCliHost)' == 'true'">
    <Compile Remove="AssemblyInfo.cs" />
  </ItemGroup>

  <ItemGroup Condition="'$(McpRhinoCliHost)' != 'true'">
    <Compile Remove="Program.cs" />
  </ItemGroup>

</Project>

<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms><UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems><TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <ServerRoot>..\..\src\MCP_Rhino.Server</ServerRoot>
  </PropertyGroup>
  <ItemGroup>
    <PackageDownload Include="Rhino.Inside" Version="[8.0.7-beta]" />
    <Reference Include="Rhino.Inside"><HintPath>$(NuGetPackageRoot)rhino.inside\8.0.7-beta\lib\net8.0-windows7.0\Rhino.Inside.dll</HintPath><Private>true</Private></Reference>
    <Reference Include="RhinoCommon" Aliases="rhinocommon"><HintPath>C:\Program Files\Rhino 8\System\netcore\RhinoCommon.dll</HintPath><Private>false</Private></Reference>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Scripting" Version="4.6.0" />
    <Compile Include="NativeChecks.csx" />
    <Compile Include="$(ServerRoot)\Contracts\Requests\RhinoScriptRequest.cs" />
    <Compile Include="$(ServerRoot)\Contracts\Responses\RhinoScriptResponses.cs" />
    <Compile Include="$(ServerRoot)\Contracts\Responses\OperationResponse.cs" />
    <Compile Include="$(ServerRoot)\Application\Interfaces\ILiveRhinoScriptExecutor.cs" />
    <Compile Include="$(ServerRoot)\Application\Interfaces\ILiveRhinoDocumentAccessor.cs" />
    <Compile Include="$(ServerRoot)\Application\Services\RhinoScriptService.cs" />
    <Compile Include="$(ServerRoot)\Infrastructure\Rhino\Live\Scripting\*.cs" />
    <Compile Include="$(ServerRoot)\Infrastructure\Plugin\PluginLoadContext.cs" />
  </ItemGroup>
</Project>
